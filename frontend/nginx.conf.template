server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri /index.html;
    }

    # No trailing slash on proxy_pass's target: nginx then forwards the
    # original request URI unchanged (/api/items stays /api/items), instead
    # of stripping the /api/ prefix that the backend's routes expect.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
